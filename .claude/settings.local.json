{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "TASK_MAX_OUTPUT_LENGTH": "20000",
    "BASH_MAX_OUTPUT_LENGTH": "8000"
  },
  "permissions": {
    "allow": [
      "Bash(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git pull *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git push *)"
    ]
  },
  "effortLevel": "medium"
}
